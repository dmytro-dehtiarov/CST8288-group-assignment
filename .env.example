# Copy this file to .env and adjust. .env is ignored by git.

# "Real" database (the one the running web app uses)
DB_URL=jdbc:mysql://localhost:3306/ckc_db
DB_USER=
DB_PASSWORD=

# Test database (used only by tests, never by the running web app)
TEST_DB_URL=jdbc:mysql://localhost:3306/ckc_test_db
TEST_DB_USER=
TEST_DB_PASSWORD=
